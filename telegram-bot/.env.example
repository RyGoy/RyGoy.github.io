# Settings for server.mjs (the bot on your own machine; docs/hosting.md). Copy to .env, fill in, and keep .env private:
# it holds the bot's token. On Cloudflare the same four are secrets, set with `npx wrangler secret put <NAME>`.
TELEGRAM_TOKEN=
WEBHOOK_SECRET=
MOD_CHAT_ID=
GITHUB_TOKEN=
# The flash card accounts' SQLite file; leave empty to keep accounts off.
ACCOUNTS_DB=accounts.db
# Where the server listens. Keep 127.0.0.1 behind a web server that gives it an HTTPS address.
HOST=127.0.0.1
PORT=8787
# When the daily reminders go out (UTC).
REMIND_AT_UTC=15:07
