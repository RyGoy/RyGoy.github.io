{{- /* The sitemap for search engines, at /sitemap.xml (named in robots.txt). Single-comment pages are left out: they
       repeat their post's page and are kept out of search (noindex in partials/head.html), and with them the list ran
       to 130,000 addresses, past the 50,000 a sitemap may hold, so search engines ignored it.
       Last modified: a post's last activity in the group (its updated_time, the time of its last comment; or, where
       the export has none, its created_time); a volume's, its latest post's; any other page, its own lastmod or date. */ -}}
{{ printf "<?xml version=\"1.0\" encoding=\"utf-8\" standalone=\"yes\"?>" | safeHTML }}
<urlset xmlns="http://www.sitemaps.org/schemas/sitemap/0.9">
  {{- range .Data.Pages }}{{ if and .Permalink (not (isset .Params "post_id")) }}
  {{- $mod := "" }}
  {{- if .Params.id }}
    {{- $mod = .Params.updated_time | default .Params.created_time }}
  {{- else if and (eq .Kind "section") (hasPrefix .Section "vol_") }}
    {{- range .Pages }}{{ with .Params.updated_time | default .Params.created_time }}{{ if or (not $mod) (gt (time.AsTime .).Unix (time.AsTime $mod).Unix) }}{{ $mod = . }}{{ end }}{{ end }}{{ end }}
  {{- else if not .Lastmod.IsZero }}
    {{- $mod = .Lastmod }}
  {{- end }}
  <url>
    <loc>{{ .Permalink }}</loc>{{ with $mod }}
    <lastmod>{{ safeHTML ((time.AsTime .).Format "2006-01-02T15:04:05-07:00") }}</lastmod>{{ end }}
  </url>
  {{- end }}{{ end }}
</urlset>
